  "dns": {
    "servers": [
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "doh.pub": [
            "1.12.12.12",
            "120.53.53.53",
            "2402:4e00::"
          ],
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6",
            "2400:3200::1",
            "2400:3200:baba::1"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ],
          "cloudflare-dns.com": [
            "1.1.1.1",
            "1.0.0.1"
          ]
        }
      },
      {
        "tag": "proxyDns",
        "type": "https",
        "server": "8.8.8.8",
        "tls": {
          "enabled": true,
          "server_name": "dns.google"
        },
        "detour": "🚀 手选节点"
      },
      {
        "tag": "localDns",
        "type": "https",
        "server": "223.5.5.5",
        "tls": {
          "enabled": true,
          "server_name": "dns.alidns.com"
        }
      },
      {
        "tag": "resolverDns",
        "type": "https",
        "server": "223.5.5.5",
        "tls": {
          "enabled": true,
          "server_name": "dns.alidns.com"
        }
      }
    ],
    "rules": [
      {
        "preferred_by": "hosts",
        "action": "route",
        "server": "hosts"
      },
      {
        "action": "route",
        "rule_set": [
          "ac-custom-direct"
        ],
        "server": "localDns"
      },
      {
        "action": "route",
        "rule_set": [
          "ac-openai",
          "geosite-openai"
        ],
        "server": "proxyDns"
      },
      {
        "action": "route",
        "rule_set": [
          "geosite-lite-cn",
          "apple-cn",
          "apple-cn-cdn",
          "microsoft-cn-cdn",
          "ac-china",
          "ac-custom-direct",
          "ac-game-download"
        ],
        "server": "localDns"
      },
      {
        "action": "route",
        "rule_set": [
          "proxy-ip-cdn",
          "proxy-domain-cdn",
          "ac-cdn-proxy"
        ],
        "server": "proxyDns"
      },
      {
        "action": "route",
        "rule_set": [
          "geosite-cn"
        ],
        "server": "localDns"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "invert": true,
        "action": "evaluate",
        "server": "localDns"
      },
      {
        "rule_set": "geoip-cn",
        "match_response": true,
        "action": "route",
        "server": "localDns"
      }
    ],
    "strategy": "prefer_ipv4",
    "final": "proxyDns",
    "reverse_mapping": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "momo",
      "address": [
        "172.31.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "udp_timeout": "30m",
      "auto_route": true,
      "auto_redirect": true,
      "exclude_mptcp": true,
      "strict_route": true,
      "route_exclude_address_set": [
        "geoip-cn"
      ],
      "exclude_uid": [
        1000
      ],
      "route_exclude_address": [
        "5.5.5.5/32",
        "10.10.1.20/32"
